<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- CONTENIDO PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Barra de Herramientas Lateral Izquierda -->
        <LinearLayout
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="#2B2B2B"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMenu"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="#3C3F41"
                android:text="☰"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:focusable="false"
                android:layout_marginBottom="16dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPen"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="#3C3F41"
                android:text="✏️"
                android:textSize="20sp"
                android:focusable="false"
                android:layout_marginBottom="8dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEraser"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="#444444"
                android:text="🧽"
                android:textSize="20sp"
                android:focusable="false"
                android:layout_marginBottom="8dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnHand"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="#444444"
                android:text="🖐"
                android:textSize="20sp"
                android:focusable="false"
                android:layout_marginBottom="8dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnZoom"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="#444444"
                android:text="🔍"
                android:textSize="20sp"
                android:focusable="false"/>

            <Space
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnProperties"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="#3C3F41"
                android:text="⚙️"
                android:textSize="18sp"
                android:focusable="false"/>
        </LinearLayout>

        <!-- Área de Lienzo y Paginación -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <com.example.notebookvectorial.views.CanvasView
                    android:id="@+id/canvasView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FFFFFF" />

                <!-- Panel Flotante de Colores -->
                <LinearLayout
                    android:id="@+id/layoutColorPalette"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:elevation="4dp"
                    android:visibility="visible"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <View
                        android:id="@+id/btnColorBlack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="12dp"/>
                    <View
                        android:id="@+id/btnColorRed"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="12dp"/>
                    <View
                        android:id="@+id/btnColorBlue"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="12dp"/>
                    <View
                        android:id="@+id/btnColorGreen"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="12dp"/>
                    <View
                        android:id="@+id/btnColorPink"
                        android:layout_width="40dp"
                        android:layout_height="40dp" />
                </LinearLayout>

                <!-- Panel Flotante de Lupa -->
                <LinearLayout
                    android:id="@+id/layoutZoomUI"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_rounded_dark"
                    android:orientation="vertical"
                    android:padding="4dp"
                    android:visibility="gone"
                    android:elevation="4dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnZoomIn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lblZoomValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="100%"
                        android:textColor="#AAAAAA"
                        android:textSize="12sp"
                        android:paddingVertical="4dp"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnZoomOut"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:text="-"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Barra Inferior de Páginas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#3C3F41"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPrevPage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#444444"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:text="◀ Anterior" />

                <TextView
                    android:id="@+id/lblPageInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Página: 1 / 1"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnNextPage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#444444"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:text="Siguiente ▶" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- DRAWER IZQUIERDO: ARCHIVOS -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#2B2B2B"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Escuela"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRefreshFiles"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:background="#444444"
                android:textColor="#FFFFFF"
                android:text="🔄"
                android:layout_marginEnd="4dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNewSubject"
                android:layout_width="0dp"
                android:layout_weight="1.5"
                android:layout_height="40dp"
                android:background="#444444"
                android:textColor="#FFFFFF"
                android:text="➕ Carpeta"
                android:layout_marginEnd="4dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTodayClass"
                android:layout_width="0dp"
                android:layout_weight="1.5"
                android:layout_height="40dp"
                android:background="#444444"
                android:textColor="#FFFFFF"
                android:text="📄 Hoy"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/treeRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSaveFile"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:background="#444444"
                android:textColor="#FFFFFF"
                android:text="💾 Guardar"
                android:layout_marginEnd="4dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDeleteFile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#444444"
                android:text="🗑️"/>
        </LinearLayout>
    </LinearLayout>

    <!-- DRAWER DERECHO: PROPIEDADES -->
    <LinearLayout
        android:id="@+id/drawerProperties"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#2B2B2B"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Propiedades"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="16dp"/>

        <LinearLayout
            android:id="@+id/layoutPenProps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/lblStrokeWidth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Grosor Lápiz: 4"
                android:textColor="#FFFFFF"/>
            <SeekBar
                android:id="@+id/sliderStrokeWidth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:max="50"
                android:progress="4"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCustomColor"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="🎨 Color Personalizado..."
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="#4CAF50"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutEraserProps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/lblEraserWidth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tamaño Goma: 20"
                android:textColor="#FFFFFF"/>
            <SeekBar
                android:id="@+id/sliderEraserWidth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:max="200"
                android:progress="20"/>

            <CheckBox
                android:id="@+id/chkDynamicEraser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Goma Dinámica (Velocidad)"
                android:textColor="#FFFFFF"
                android:buttonTint="#4CAF50"/>
        </LinearLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>